# results.config
#
# Extract boolean/text results from the artifacts collected off the containers.
# Format:  tag = [container:]path : OPERATOR : value

#DOC: The custom Slowloris client actually started.
_attack_started    = attacker:/var/log/slowloris.log : CONTAINS : SLOWLORIS start

#DOC: The custom detector actually started.
_detector_started  = monitor:/var/log/detector.log : CONTAINS : DETECTOR start

#DOC: The detector flagged the attacker source (172.25.0.20) as Slowloris.
_detected_attacker = monitor:/var/log/detector.log : CONTAINS : DETECTED SLOWLORIS src=172.25.0.20

#DOC: The detector (wrongly) flagged the benign generator (172.25.0.30) -- a false positive.
_flagged_benign    = monitor:/var/log/detector.log : CONTAINS : DETECTED SLOWLORIS src=172.25.0.30

#DOC: Availability degraded during the attack (benign-gen run with phase "during").
_during_degraded   = benign-gen:/var/log/benign.log : CONTAINS : RESULT phase=during verdict=DEGRADED

#DOC: Availability recovered after mitigation (benign-gen run with phase "after").
_after_ok          = benign-gen:/var/log/benign.log : CONTAINS : RESULT phase=after verdict=OK
