# goals.config
#
# The five automatically-assessed objectives from the proposal. Each goal is a
# boolean over the result tags defined in results.config.

# 1. Attack effective: availability degraded while the attack ran.
attack_effective     = boolean : (_during_degraded)

# 2. Detector fires: the attacker source was labelled as Slowloris.
detector_fires       = boolean : (_detected_attacker)

# 3. Low false positives: the benign slow clients were NOT flagged.
low_false_positives  = boolean : (_detector_started and_not _flagged_benign)

# 4. Mitigation restores service: availability recovered after the defense.
mitigation_restores  = boolean : (_after_ok)

# 5. Custom code executed: both the attacker and detector scripts ran.
custom_code_executed = boolean : (_attack_started and _detector_started)
