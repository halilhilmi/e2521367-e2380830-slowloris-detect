# Filename : start.config
# Description:
#     Baseline topology for the slowloris-detect lab.
#     One LAN with four nodes: attacker, victim (Apache prefork),
#     benign traffic generator, and a monitor/IDS.

GLOBAL_SETTINGS
	# Container where the instructor performs grading (reads collected artifacts).
	GRADE_CONTAINER monitor

	# Directory used to transfer artifacts to/from containers.
	HOST_HOME_XFER seed_dir/

	# Master seed string specific to this laboratory (drives per-student parameters).
	LAB_MASTER_SEED slowloris_detect_seed

# SUBNETS
NETWORK SLNET
	MASK 172.25.0.0/24
	GATEWAY 172.25.0.100

# Container name and settings
CONTAINER victim
	USER ubuntu
	TERMINALS 1
	SLNET 172.25.0.10

CONTAINER attacker
	USER ubuntu
	TERMINALS 1
	SLNET 172.25.0.20

CONTAINER benign-gen
	USER ubuntu
	TERMINALS 1
	SLNET 172.25.0.30

CONTAINER monitor
	USER ubuntu
	TERMINALS 1
	SLNET 172.25.0.40
