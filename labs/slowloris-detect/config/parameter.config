# parameter.config
#
# Per-student individualization. See docs/labdesigner (parameter.config format).
# RAND_REPLACE replaces a literal token in the named file with a random integer
# in [lower, upper] (optional step), so each lab instance has different attack
# and detector thresholds and must be solved from observed behaviour.

# ---- Attack parameters (attacker/slowloris.py) ----
# Number of concurrent connections the attacker opens.
num_conn  : RAND_REPLACE : attacker:/home/ubuntu/slowloris.py : NUM_CONNECTIONS : 150 : 400 : 10
# Seconds between the "drip" bytes that keep each partial request alive.
drip_sec  : RAND_REPLACE : attacker:/home/ubuntu/slowloris.py : DRIP_SECONDS : 10 : 20

# ---- Detector parameters (monitor/detector.py) ----
# Per-source concurrent-connection count above which a source is suspicious.
conc_thr  : RAND_REPLACE : monitor:/home/ubuntu/detector.py : CONC_THRESHOLD : 40 : 80 : 5
# Seconds a connection may sit in the header-reading phase before it looks slow.
slow_thr  : RAND_REPLACE : monitor:/home/ubuntu/detector.py : SLOW_THRESHOLD : 8 : 15
